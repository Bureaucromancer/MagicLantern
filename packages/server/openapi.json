{
  "openapi": "3.1.0",
  "info": {
    "title": "Magic Lantern",
    "version": "v1",
    "description": "The HTTP API of the Magic Lantern daemon. Errors use one envelope: `{ error, message, issues? }`, where `error` is a stable kebab-case code.\n\nBeyond the answers each operation lists, any request can get 500 `internal` (the cause is only in the daemon's log), and an unknown API route, or a documented path under a method it does not list, gets 404 `not-found` (never 405).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lantern_session",
        "description": "Set by `POST /api/v1/session`. In auth mode `password` every `/api/v1` route except `/api/v1/session` requires it; in mode `none` nothing does."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/info": {
      "get": {
        "operationId": "getInfo",
        "summary": "Daemon and API version",
        "tags": [
          "info"
        ],
        "responses": {
          "200": {
            "description": "The daemon and API version.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The daemon and API version.",
                  "type": "object",
                  "required": [
                    "name",
                    "version",
                    "apiVersion"
                  ],
                  "properties": {
                    "name": {
                      "description": "Always `lantern`.",
                      "const": "lantern",
                      "type": "string"
                    },
                    "version": {
                      "description": "The daemon's version.",
                      "type": "string"
                    },
                    "apiVersion": {
                      "description": "The API version this daemon serves.",
                      "const": "v1",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: password mode and no valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "`unauthenticated`: password mode and no valid session.",
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                      "description": "A stable kebab-case code, e.g. `unauthenticated`. Clients branch on this.",
                      "type": "string"
                    },
                    "message": {
                      "description": "Fallback prose for people; never parse it.",
                      "type": "string"
                    },
                    "issues": {
                      "description": "Present on `invalid` (422) answers.",
                      "type": "array",
                      "items": {
                        "description": "One validation failure.",
                        "type": "object",
                        "required": [
                          "path",
                          "message"
                        ],
                        "properties": {
                          "path": {
                            "description": "The field at fault as a JSON pointer (RFC 6901, e.g. `/password`; `~` and `/` in a key are written `~0` and `~1`); for an unknown field, the pointer to that field; `''` for the whole body.",
                            "type": "string"
                          },
                          "message": {
                            "description": "What is wrong with it, in prose.",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "`forbidden-host`: the Host header names a host the daemon does not answer to (see `allowedHosts`). `forbidden-origin`: the request comes from a web page whose origin is not allowed (see `allowedOrigins`).",
