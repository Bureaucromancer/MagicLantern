                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                      "description": "A stable kebab-case code, e.g. `unauthenticated`. Clients branch on this.",
                      "type": "string"
                    },
                    "message": {
                      "description": "Fallback prose for people; never parse it.",
                      "type": "string"
                    },
                    "issues": {
                      "description": "Present on `invalid` (422) answers.",
                      "type": "array",
                      "items": {
                        "description": "One validation failure.",
                        "type": "object",
                        "required": [
                          "path",
                          "message"
                        ],
                        "properties": {
                          "path": {
                            "description": "The field at fault as a JSON pointer (RFC 6901, e.g. `/password`; `~` and `/` in a key are written `~0` and `~1`); for an unknown field, the pointer to that field; `''` for the whole body.",
                            "type": "string"
                          },
                          "message": {
                            "description": "What is wrong with it, in prose.",
                            "type": "string"
                          }
                        }
