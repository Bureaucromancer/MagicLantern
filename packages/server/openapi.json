        "responses": {
          "200": {
            "description": "The auth mode and whether this request is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The auth mode and whether this request is signed in.",
                  "type": "object",
                  "required": [
                    "mode",
                    "authenticated"
                  ],
                  "properties": {
                    "mode": {
                      "description": "`none`: no sign-in (the default, loopback only unless trusted). `password`: one install-wide password.",
                      "anyOf": [
                        {
                          "const": "none",
                          "type": "string"
                        },
                        {
                          "const": "password",
                          "type": "string"
                        }
                      ]
                    },
                    "authenticated": {
                      "description": "Whether this request may use the API: always true in mode `none`; in mode `password`, whether it carries a valid session.",
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
