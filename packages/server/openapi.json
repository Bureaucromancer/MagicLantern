            "description": "The libraries this install knows.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The libraries this install knows.",
                  "type": "object",
                  "required": [
                    "libraries"
                  ],
                  "properties": {
                    "libraries": {
                      "description": "Every registered library.",
                      "type": "array",
                      "items": {
                        "description": "One library.",
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "status"
                        ],
                        "properties": {
                          "id": {
                            "pattern": "^lib_[0-9A-HJKMNP-TV-Z]{26}$",
                            "description": "A library id: `lib_` and a ULID.",
                            "type": "string"
                          },
                          "name": {
                            "description": "The display name.",
                            "type": "string"
                          },
                          "status": {
                            "description": "`ok`: usable. `read-only`: written by a newer daemon that this one can still read. `unavailable`: cannot be opened (see `reason`).",
                            "anyOf": [
                              {
                                "const": "ok",
                                "type": "string"
                              },
                              {
                                "const": "read-only",
                                "type": "string"
                              },
                              {
                                "const": "unavailable",
                                "type": "string"
                              }
                            ]
                          },
                          "reason": {
                            "description": "Why the library is read-only or unavailable, in prose.",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
