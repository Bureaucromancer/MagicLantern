exports[`prepare (SD2) > maps LoRAs by path, the hires pass, a native sampler and a batch 1`] = `
{
  "batch_count": 4,
  "cache_mode": "",
  "clip_skip": 2,
  "embed_image_metadata": true,
  "height": 1024,
  "hires": {
    "denoising_strength": 0.5,
    "enabled": true,
    "scale": 1.5,
    "steps": 0,
    "target_height": 0,
    "target_width": 0,
    "upscaler": "Lanczos",
  },
  "image_preprocess": "",
  "lora": [
    {
      "is_high_noise": false,
      "multiplier": 0.6,
      "path": "style/film-grain.safetensors",
    },
  ],
  "negative_prompt": "",
  "output_compression": 100,
  "output_format": "png",
  "prompt": "a lighthouse at dusk",
  "sample_params": {
    "guidance": {
      "slg": {
        "layer_end": 0.2,
        "layer_start": 0.01,
        "layers": [
          7,
          8,
          9,
        ],
        "scale": 0,
      },
    },
    "sample_method": "euler_new",
    "sample_steps": 20,
    "scheduler": "karras",
    "shifted_timestep": 0,
  },
  "seed": 9,
  "vae_tiling_params": {
    "enabled": true,
    "target_overlap": 0.5,
    "tile_size_x": 0,
    "tile_size_y": 0,
  },
  "width": 1024,
}
`;

