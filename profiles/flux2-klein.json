        "note": "Detailed natural-language prompts. The token limit is the text encoder's max_sequence_length."
      },
      "negative_prompt": {
        "behaviour": "unconfirmed",
        "source": "unconfirmed",
        "note": "Base runs real CFG, but whether a user negative prompt is honoured is unconfirmed."
      },
      "modes": {
        "txt2img": {
          "defaults": {
            "sampling.steps": {
              "value": 50,
              "source": "card-base-4b",
              "note": "BFL's card and the Diffusers default; sd.cpp's example uses 20."
            },
            "sampling.cfg": {
              "value": 4,
              "source": "sdcpp",
              "note": "sd.cpp's example and the Diffusers default agree."
