            },
            "sampling.cfg": {
              "value": 1,
              "source": "sdcpp"
            },
            "sampling.sampler": {
              "value": "euler",
              "source": "sdcpp"
            }
          }
        },
        "edit": {
          "defaults": {
            "sampling.steps": {
              "value": 4,
              "source": "card-9b"
            },
            "sampling.cfg": {
              "value": 1,
              "source": "sdcpp"
            },
            "sampling.sampler": {
              "value": "euler",
              "source": "sdcpp"
