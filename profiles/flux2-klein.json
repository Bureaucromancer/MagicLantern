{
  "schema_version": 1,
  "family": "flux2-klein",
  "name": "FLUX.2 [klein]",
  "prompt": {
    "dialect": "natural",
    "encoders": ["Qwen3"],
    "token_limit": 512,
    "source": "card-4b",
    "note": "Each variant names its Qwen3 size: 4B for the 4B models, 8B for the 9B ones."
  },
  "negative_prompt": {
    "behaviour": "unconfirmed",
    "source": "unconfirmed",
    "note": "Differs by variant; see each variant."
  },
  "resolution": {
    "multiple_of": 16,
    "native": {
      "width": 1024,
      "height": 1024
    },
    "source": "card-4b",
    "note": "1024x1024 is the distilled models' size; the research gives no other for Base."
  },
  "modes": {
    "txt2img": {
      "defaults": {
        "geometry.width": {
          "value": 1024,
          "source": "card-4b"
        },
        "geometry.height": {
          "value": 1024,
          "source": "card-4b"
        }
      }
    },
    "edit": {
      "collections": {
        "inputs.ref": {
          "min": 1,
          "max": 4,
          "source": "card-4b",
          "note": "Single- and multi-reference editing; references are downscaled to about 1024x1024 in area."
        }
      }
    }
  },
  "warnings": [
    {
      "code": "negative_prompt_ignored",
      "when": {
        "sampling.cfg": {
          "maximum": 1
        },
        "prompt.negative": {
          "minLength": 1
        }
      },
      "message": "At CFG 1 there is no unconditional pass, so the negative prompt has no effect. The distilled variants run at CFG 1."
    }
  ],
  "variants": [
    {
      "id": "distilled-4b",
      "name": "FLUX.2 [klein] 4B",
      "licence": {
        "id": "Apache-2.0",
        "name": "Apache License 2.0",
        "commercial_use": true,
        "source": "card-4b"
      },
      "prompt": {
        "dialect": "natural",
        "encoders": ["Qwen3-4B"],
        "token_limit": 512,
        "source": "card-4b",
        "note": "Detailed natural-language prompts. The token limit is the text encoder's max_sequence_length."
      },
      "negative_prompt": {
        "behaviour": "distilled",
        "source": "card-4b",
        "note": "Step-distilled and run at cfg 1, where a negative prompt has no effect."
      },
      "modes": {
        "txt2img": {
          "defaults": {
            "sampling.steps": {
              "value": 4,
              "source": "card-4b"
            },
            "sampling.cfg": {
              "value": 1,
              "source": "sdcpp"
            },
            "sampling.sampler": {
              "value": "euler",
              "source": "sdcpp"
            }
          }
        },
        "edit": {
          "defaults": {
            "sampling.steps": {
              "value": 4,
              "source": "card-4b"
            },
            "sampling.cfg": {
              "value": 1,
              "source": "sdcpp"
            },
            "sampling.sampler": {
              "value": "euler",
              "source": "sdcpp"
            }
          }
        }
      }
    },
    {
      "id": "distilled-9b",
      "name": "FLUX.2 [klein] 9B",
      "licence": {
        "id": "LicenseRef-FLUX-Non-Commercial",
        "name": "FLUX Non-Commercial License",
        "commercial_use": false,
        "source": "card-9b"
      },
      "prompt": {
        "dialect": "natural",
        "encoders": ["Qwen3-8B"],
        "token_limit": 512,
        "source": "card-9b",
        "note": "Detailed natural-language prompts. The token limit is the text encoder's max_sequence_length."
      },
      "negative_prompt": {
